# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Postgres connection string (Project settings, Database).
# For serverless hosting use the pooler string (port 6543) instead of the direct one.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Long random string used to hash IP addresses for rate limiting. Generate with:
#   openssl rand -hex 32
IP_HASH_SECRET=

# Public address of the site, used to build share links. Optional in development.
# On the live site set it before building: search engines and link previews get their
# canonical addresses, the sitemap and the preview image from it.
# SITE_URL=https://minelog.org

# The API service (npm run dev:api). Both are optional in development.
# Where saved logs are opened, so the API can link to them from its own host.
# SITE_URL is also read by the site, see above. Default here: http://localhost:3000
# The API's own public address, for links that stay on the API (raw text).
# API_URL=https://api.minelog.org
# Port for npm run dev:api and start:api. Default 4000.
# API_PORT=4000

# Secret for the scheduled job that keeps the database awake. Vercel sends it as
# "Authorization: Bearer <value>" when it calls /api/heartbeat. Without it the
# address answers 404 to everyone. Generate one with:
#   openssl rand -hex 24
# CRON_SECRET=

# Shared secret between the site and the API. When a log is deleted through the API,
# it tells the site to drop its cached copy of the page data. Use the SAME value in both
# Vercel projects. Without it the cached copy just expires after LOG_CACHE_SECONDS.
#   openssl rand -hex 24
# REVALIDATE_SECRET=
